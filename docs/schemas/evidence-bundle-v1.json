{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://faultline.invalid/schemas/evidence-bundle-v1.json",
  "title": "Faultline evidence bundle manifest, version 1",
  "description": "manifest.json at the root of an evidence bundle (a zip file). Every other file in the bundle must be listed here with its sha256; nothing may be present that is not listed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "bundle_id", "created_at", "mode", "witness_id", "witness_class", "witness_key",
               "claim", "files", "run_summary", "worlds", "artifact", "oracle"],
  "properties": {
    "schema_version": {"const": "1"},
    "kind": {"const": "faultline-evidence-bundle"},
    "bundle_id": {"type": "string", "pattern": "^bdl_[0-9a-f]{24}$"},
    "created_at": {"type": "string"},
    "mode": {"enum": ["FIXTURE", "LIVE", "REPLAY"]},
    "witness_id": {"type": "string", "minLength": 1},
    "witness_class": {"enum": ["BREAK", "SILENT_DIVERGENCE"]},
    "witness_key": {"type": "string", "pattern": "^wk_[0-9a-f]{40}$"},
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "not_claimed"],
      "properties": {
        "statement": {"type": "string", "minLength": 1},
        "not_claimed": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "entry_point", "args"],
      "properties": {
        "name": {"type": "string"}, "version": {"type": "string"}, "entry_point": {"type": "string"},
        "args": {"type": "object"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_hash", "source_dir"],
      "properties": {"content_hash": {"type": "string", "pattern": "^a_[0-9a-f]{40}$"}, "source_dir": {"type": "string"}}
    },
    "worlds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "consumer", "env_profile"],
      "properties": {
        "reference": {"type": "string", "pattern": "^w_[0-9a-f]{40}$"},
        "consumer": {"type": "string", "pattern": "^w_[0-9a-f]{40}$"},
        "env_profile": {"type": "string"}
      }
    },
    "run_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_passes", "consumer_failures", "all_fresh", "signature"],
      "properties": {
        "reference_passes": {"const": 3}, "consumer_failures": {"const": 3}, "all_fresh": {"const": true},
        "signature": {"type": "object"}
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 300},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
